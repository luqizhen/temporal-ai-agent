{
  "name": "temporal-agent",
  "version": "0.1.0",
  "description": "A durable, production-grade AI agent built on Temporal orchestration",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start:worker": "node dist/worker/worker.js",
    "start:api": "node dist/api/server.js",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/common": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "openai": "^4.85.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@temporalio/testing": "^1.11.7",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.20.0",
    "nock": "^14.0.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
