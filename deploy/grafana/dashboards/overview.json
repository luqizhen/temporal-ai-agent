apiVersion: v1
kind: ConfigMap
metadata:
  name: temporal-agent-grafana-dashboards
  labels:
    grafana_dashboard: "1"
data:
  temporal-agent-overview.json: |
    {
      "dashboard": {
        "title": "Temporal Agent - Overview",
        "tags": ["temporal-agent"],
        "timezone": "browser",
        "panels": [
          {
            "title": "Workflows Started / Completed",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "targets": [
              {"expr": "sum(rate(agent_workflows_started_total[5m]))", "legendFormat": "Started"},
              {"expr": "sum(rate(agent_workflows_completed_total[5m]))", "legendFormat": "Completed"}
            ]
          },
          {
            "title": "Workflow Status",
            "type": "piechart",
            "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
            "targets": [
              {"expr": "sum(agent_workflows_completed_total) by (status)", "legendFormat": "{{status}}"}
            ]
          },
          {
            "title": "Workflow Duration (p50, p95, p99)",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
            "targets": [
              {"expr": "histogram_quantile(0.50, sum(rate(agent_workflow_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
              {"expr": "histogram_quantile(0.95, sum(rate(agent_workflow_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
              {"expr": "histogram_quantile(0.99, sum(rate(agent_workflow_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
            ]
          },
          {
            "title": "Tool Calls by Tool",
            "type": "barchart",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
            "targets": [
              {"expr": "sum(rate(agent_tool_calls_total[5m])) by (tool_name)", "legendFormat": "{{tool_name}}"}
            ]
          },
          {
            "title": "LLM Token Usage",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
            "targets": [
              {"expr": "sum(rate(agent_llm_tokens_total{type=\"prompt\"}[5m]))", "legendFormat": "Prompt Tokens"},
              {"expr": "sum(rate(agent_llm_tokens_total{type=\"completion\"}[5m]))", "legendFormat": "Completion Tokens"}
            ]
          },
          {
            "title": "API Request Rate",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
            "targets": [
              {"expr": "sum(rate(http_requests_total[5m])) by (status)", "legendFormat": "{{status}}"}
            ]
          },
          {
            "title": "API Latency (p50, p99)",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
            "targets": [
              {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
              {"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
            ]
          },
          {
            "title": "LLM Errors",
            "type": "stat",
            "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24},
            "targets": [
              {"expr": "sum(increase(agent_llm_errors_total[1h]))", "legendFormat": "Errors (1h)"}
            ]
          }
        ],
        "refresh": "30s",
        "time": {"from": "now-1h", "to": "now"}
      }
    }
