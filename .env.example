# =============================================================================
# Temporal Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env
# =============================================================================

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- LLM Provider ---
# Base URL for the OpenAI-compatible LLM API
# Z.AI:        https://api.z.ai/v1
# OpenAI:      https://api.openai.com/v1
# Local/Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.z.ai/v1

# API key for the LLM provider
LLM_API_KEY=your-api-key-here

# Model identifier
# Z.AI:        glm-4
# OpenAI:      gpt-4, gpt-4o, gpt-4o-mini
LLM_MODEL=gpt-4

# Generation parameters
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- Agent ---
AGENT_MAX_ITERATIONS=20
APPROVAL_TIMEOUT_HOURS=24
MAX_STATE_MESSAGES=50
WORKSPACE_DIR=./workspace

# --- API Server ---
API_PORT=3000
CORS_ORIGIN=*

# --- Tool: Web Search ---
# API key for the web search provider (e.g., SerpAPI)
# WEB_SEARCH_API_KEY=

# --- Tool: Code Execution ---
CODE_EXEC_TIMEOUT_MS=30000
CODE_EXEC_MAX_MEMORY_MB=256
